# Puerto en el que escuchará Ollama en tu red local
OLLAMA_PORT=11434

# Versión de la imagen de Docker a utilizar (latest asegura la más nueva)
OLLAMA_VERSION=latest

# Ruta local donde se guardarán los modelos descargados en tu máquina
OLLAMA_DATA_PATH=./data/ollama

# (Opcional) Si quieres que Ollama sea accesible desde fuera de la VM
OLLAMA_HOST=0.0.0.0
